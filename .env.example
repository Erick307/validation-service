# HTTP port for the health check endpoint (different from image-intake-webhook)
PORT=3001

# PostgreSQL connection string (shared with image-intake-webhook)
DATABASE_URL=postgresql://user:password@localhost:5432/imageanalizer

# Anthropic API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for image validation
CLAUDE_MODEL=claude-sonnet-4-5

# pg-boss worker concurrency — max concurrent jobs per worker instance
WORKER_CONCURRENCY=5

# pg-boss retry configuration
RETRY_LIMIT=3
RETRY_DELAY_SECONDS=5
